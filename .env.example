PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
# Use a persistent disk on Render and set DATA_DIR to its mount path, e.g. /var/data
DATA_DIR=./data

# PayFast recurring billing is not enabled in this starter build.
# Add merchant credentials only after completing sandbox setup and webhook verification.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
